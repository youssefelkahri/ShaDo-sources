[{"p":"https://lodynet.watch/wp-content/uploads/2026/11/photo_2026-11-14_18-29-39.webp","r":[["مسلسل الملكة مترجم الحلقة 1","{base}/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d8%a7%d9%84%d9%85%d9%84%d9%83%d8%a9-%d9%85%d8%aa%d8%b1%d8%ac%d9%85-%d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a9-1","https://lodynet.watch/wp-content/uploads/2026/11/photo_2026-11-17_06-26-38-220x220.webp"]],"at":1794998713432,"t":"TvSeries","d":"مشاهدة و تحميل مسلسل الرومانسية و الدراما الهندي لعلّه الحب Shayad Yahi Hai Pyaar بطولة أديتي ديف شارما وداكش بوري مترجم بجودة عالية الوضوح تدور أحداث المسلسل الهندي الرومانسي الدرامي «لعلّه الحب» حول بريتي أرورا، امرأة تبلغ من العمر 35 عامًا، تجد نفسها أمام سلسلة من خيبات الأمل بعد أن تخسر الترقية التي كانت تطمح إليها في عملها، وتنتهي علاقتها العاطفية التي استمرت خمس سنوات بطريقة مؤلمة. وبين ضغوط العمل وتوقعات المجتمع التي تحاصرها بسبب تأخر زواجها، تحاول بريتي استعادة ثقتها بنفسها والبدء من جديد. تتغير حياتها مع عودة آراف أهوجا، الشاب الذي يصغرها بعشر سنوات، وشقيق صديقتها المقربة، إلى حياتها من جديد. ومع مرور الوقت، تتحول العلاقة بينهما من معرفة قديمة إلى مشاعر حب صادقة تمنح بريتي الأمل والسعادة اللذين افتقدتهما طويلًا. لكن علاقتهما تواجه رفضًا اجتماعيًا وانتقادات بسبب فارق العمر بينهما، لتجد بريتي وآراف نفسيهما أمام اختبار صعب، فهل سينتصر حبهما على قيود المجتمع وتقاليده؟ المسلسل مقتبس رسميًا من الدراما الكورية الرومانسية الشهيرة «Something in the Rain»، ويقدم حكاية عاطفية عن الحب وفارق العمر والتوقعات الاجتماعية. بطولة: أديتي ديف شارما \u2013 داكش بوري","u":"category/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%84%d8%b9%d9%84%d9%91%d9%87-%d8%a7%d9%84%d8%ad%d8%a8-%d9%85%d8%aa%d8%b1%d8%ac%d9%85","pu":"category/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%84%d8%b9%d9%84%d9%91%d9%87-%d8%a7%d9%84%d8%ad%d8%a8-%d9%85%d8%aa%d8%b1%d8%ac%d9%85","e":[["{base}/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%84%d8%b9%d9%84%d9%91%d9%87-%d8%a7%d9%84%d8%ad%d8%a8-%d9%85%d8%aa%d8%b1%d8%ac%d9%85-%d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a9-1","الحلقة 1",-1,1],["{base}/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%84%d8%b9%d9%84%d9%91%d9%87