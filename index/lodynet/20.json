ة، ولكل سرٍّ ثمن. **بطولة :** * إيشان داوان في دور جيت. * ديبشاندريما سينغها روي في دور سوميا.","u":"category/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%87%d9%88%d8%b3-%d9%85%d8%aa%d8%b1%d8%ac%d9%85","pu":"category/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%87%d9%88%d8%b3-%d9%85%d8%aa%d8%b1%d8%ac%d9%85","e":[["{base}/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%87%d9%88%d8%b3-%d9%85%d8%aa%d8%b1%d8%ac%d9%85-%d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a9-1","الحلقة 1",-1,1],["{base}/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%87%d9%88%d8%b3-%d9%85%d8%aa%d8%b1%d8%ac%d9%85-%d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a9-2","الحلقة 2",-1,2],["{base}/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%87%d9%88%d8%b3-%d9%85%d8%aa%d8%b1%d8%ac%d9%85-%d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a9-3","الحلقة 3",-1,3],["{base}/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%87%d9%88%d8%b3-%d9%85%d8%aa%d8%b1%d8%ac%d9%85-%d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a9-4","الحلقة 4",-1,4],["{base}/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%87%d9%88%d8%b3-%d9%85%d8%aa%d8%b1%d8%ac%d9%85-%d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a9-5","الحلقة 5",-1,5],["{base}/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%87%d9%88%d8%b3-%d9%85%d8%aa%d8%b1%d8%ac%d9%85-%d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a9-6","الحلقة 6",-1,6],["{base}/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%87%d9%88%d8%b3-%d9%85%d8%aa%d8%b1%d8%ac%d9%85-%d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a9-7","الحلقة 7",-1,7],["{base}/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%87%d9%88%d8%b3-%d9%85%d8%aa%d8%b1%d8%ac%d9%85-%d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a9-8","الحلقة 8",-1,8],["{base}/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%87%d9%88%d8%b3-%d9%85%d8%aa%d8%b1%d8%ac%d9%85-%d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a9-9","الحلقة 9",-1,9],["{base}/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%87%d9%88%d8%b3-%d9%85%d8%aa%d8%b1%d8%ac%d9%85-%d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a9-10","الحلقة 10",-1,10],["{base}/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%87%d9%88%d8%b3-%d9%85%d8%aa%d8%b1%d8%ac%d9%85-%d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a9-11","الحلقة 11",-1,11],["{base}/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%87%d9%88%d8%b3-%d9%85%d8%aa%d8%b1%d8%ac