[{"p":"https://lodynet.top/wp-content/uploads/2026/11/photo_2026-11-14_18-32-35.webp","r":[],"at":1795342769435,"t":"TvSeries","d":"مشاهدة وتحميل المسلسل الهندي الدرامي والرومانسي أمنية حب الموسم الثاني Mannat: Har Khushi Paane Ki Season 2 مترجم للعربية بطولة تانفي دوجرا وناميك بول بجودة عالية الوضوح WebDL 1080p تبدأ أحداث الموسم الثاني حول «منات جونيجا»، فتاة شابة تنتمي إلى عائلة متوسطة الحال، تدير مطعم عائلتها الشعبي «فيرات دا دابا»، الذي يمثل لها إرثًا عائليًا يحمل ذكريات والدها وأحلام أسرتها. تؤمن منات بأن الطعام ليس مجرد وجبات تُقدَّم، بل هو مزيج من الحب والتقاليد والذكريات التي تجمع أفراد العائلة.على الجانب الآخر، يظهر «كبير أوبيروي»، صاحب مطعم فاخر يُدعى «ميزبااني»، والذي يؤمن بالدقة والابتكار والسعي نحو الكمال. وعلى الرغم من اختلاف شخصيتيهما ونظرتهما إلى عالم الطهي، تجمعهما المنافسة في عالم المطاعم، لتبدأ بينهما سلسلة من المواجهات والخلافات التي تحمل في طياتها انجذابًا غير متوقع.ومع تصاعد الصراع بين مطعم منات التقليدي ومطعم كبير الفاخر، تتشابك حياتهما وسط الطموحات والأسرار العائلية والأحداث المرتبطة بالماضي، لتجد منات نفسها أمام تحديات جديدة تهدد استقرار حياتها، بينما تتطور علاقتها بكبير بين المنافسة والمشاعر المتناقضة. فهل تتحول المنافسة بينهما إلى قصة حب، أم أن أسرار الماضي ستقف عائقًا أمام سعادتهما؟ بطولة:تانفي دوجرا \u2013 ناميك بول \u2013 كيشوري شاهاني \u2013 سوبريا شوكلا","u":"category/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d8%a3%d9%85%d9%86%d9%8a%d8%a9-%d8%ad%d8%a8-%d8%a7%d9%84%d9%85%d9%88%d8%b3%d9%85-%d8%a7%d9%84%d8%ab%d8%a7%d9%86%d9%8a-%d9%85%d8%aa%d8%b1%d8%ac%d9%85","pu":"category/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d8%a3%d9%85%d9%86%d9%8a%d8%a9-%d8%ad%d8%a8-%d8%a7%d9%84%d9%85%d9%88%d8%b3%d9%85-%d8%a7%d9%84%d8%ab%d8%a7%d9%86%d9%8a-%d9%85%d8%aa%d8%b1%d8%ac%d9%85","e":[["https://lodynet.top/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d8%a3%d9%85%d9%86%d9%8a%d8%a9-%d8%ad%d8%a8-%d8%a7%d9%84%d9%85%d9%88%d8%b3%d9%85-%d8%a7%d9%84%d8%ab%d8%a7%d9%86%d9%8a-%d9%85%d8%aa%d8%b1%d8%ac%d9%85-%d8%a7%d9%84%d8%ad","الحلقة 1",-1,1],["https://lodynet.top/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d8%a