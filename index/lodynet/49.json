[{"p":"https://lodynet.watch/wp-content/uploads/2015/02/نظرة-220x220.webp","r":[],"at":1795863125257,"t":"TvSeries","d":"مشاهدة وتحميل المسلسل الهندي الرومانسي والدرامي من النظرة الثانية ?Iss Pyaar Ko Kya Naam Doon مترجم بطولة بارون سوبتي، سانايا إيراني بجودة WebDL 1080p تدور الأحداث حول «كوشي»، فتاة مرحة وبسيطة تتغير حياتها عندما تلتقي بـ«أرناف»، رجل الأعمال الثري والقاسي الذي لا يؤمن بالحب. تبدأ علاقتهما بالخلافات والمواجهات المستمرة، لكن مع مرور الوقت تتحول تلك الصدامات إلى مشاعر حب قوية. وبين أسرار الماضي ومكائد العائلة والعقبات التي تقف في طريقهما، يحاول أرناف وكوشي الحفاظ على حبهما ومواجهة كل ما يهدد علاقتهما. بطولة: بارون سوبتي، سانايا إيراني، ديبالي بَنسال، أكشاي دوجرا","u":"%d9%85%d9%86-%d8%a7%d9%84%d9%86%d8%b8%d8%b1%d8%a9-%d8%a7%d9%84%d8%ab%d8%a7%d9%86%d9%8a%d8%a9-%d9%85%d8%aa%d8%b1%d8%ac%d9%85-%d8%ad%d9%84%d9%82%d8%a9-202-hd","pu":"%d9%85%d9%86-%d8%a7%d9%84%d9%86%d8%b8%d8%b1%d8%a9-%d8%a7%d9%84%d8%ab%d8%a7%d9%86%d9%8a%d8%a9-%d9%85%d8%aa%d8%b1%d8%ac%d9%85-%d8%ad%d9%84%d9%82%d8%a9-202-hd","e":[["{base}/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%85%d9%86-%d8%a7%d9%84%d9%86%d8%b8%d8%b1%d8%a9-%d8%a7%d9%84%d8%ab%d8%a7%d9%86%d9%8a%d8%a9-%d9%85%d8%aa%d8%b1%d8%ac%d9%85-%d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a9-1","الحلقة 1",-1,1],["{base}/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%85%d9%86-%d8%a7%d9%84%d9%86%d8%b8%d8%b1%d8%a9-%d8%a7%d9%84%d8%ab%d8%a7%d9%86%d9%8a%d8%a9-%d9%85%d8%aa%d8%b1%d8%ac%d9%85-%d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a92","الحلقة 2",-1,2],["{base}/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%85%d9%86-%d8%a7%d9%84%d9%86%d8%b8%d8%b1%d8%a9-%d8%a7%d9%84%d8%ab%d8%a7%d9%86%d9%8a%d8%a9-%d9%85%d8%aa%d8%b1%d8%ac%d9%85-%d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a93","الحلقة 3",-1,3],["{base}/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%85%d9%86-%d8%a7%d9%84%d9%86%d8%b8%d8%b1%d8%a9-%d8%a7%d9%84%d8%ab%d8%a7%d9%86%d9%8a%d8%a9-%d9%85%d8%aa%d8%b1%d8%ac%d9%85-%d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a9-4-3","الحلقة 4",-1,4],["{base}/dropapk-792","الحلقة 5",-1,5],["{base}/%d9%85%d8%b3%d9%84%d8%b3%d9%84-%d9%85%d9%86-%d8%a7%